# --- HTTP ---
PORT=4001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=vertex
DB_PASSWORD=vertex
DB_NAME=vertex_pet
DB_SSLMODE=disable
DB_SEARCH_PATH=pet
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# --- JWT ---
# ใส่ PEM ตรงๆ (production ควรมาจาก Secret) ถ้าว่างจะ fallback ไปอ่าน JWT_PUBLIC_KEY_PATH
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=keys/public.pem

# JWT_PUBLIC_KEYS รับ PEM หลายบล็อกต่อกันในค่าเดียว (ไม่ต้องมีตัวคั่น)
# ใช้ระหว่าง rotate key เพื่อยอมรับทั้งใบเก่าและใบใหม่พร้อมกัน
# ดูขั้นตอนเต็มที่ docs/KEY_ROTATION.md
JWT_PUBLIC_KEYS=
# ⚠️ เปิด JWT_ISSUER / JWT_AUDIENCE ได้หลัง auth-service ออก claim สองตัวนี้แล้ว
#    อย่างน้อย 72 ชม. (เท่าอายุ token เดิม) ไม่งั้น token ที่ผู้ใช้ถืออยู่จะใช้ไม่ได้ทันที
JWT_ISSUER=
JWT_AUDIENCE=

# สะพานชั่วคราวระหว่างรอ roles claim จาก auth-service (Phase 1A)
# user id ในรายการนี้จะได้ SUPER_ADMIN — ถอดออกทันทีเมื่อ roles claim พร้อมใช้
# คั่นด้วย comma
ADMIN_USER_IDS=

# --- Downstream ---
EVENT_SERVICE_URL=http://localhost:4002
EVENT_PUBLISH_TIMEOUT=5s

# --- Logging ---
LOG_LEVEL=info
LOG_BODY=false
