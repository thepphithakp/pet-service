# --- HTTP ---
PORT=4001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=vertex
DB_PASSWORD=vertex
DB_NAME=vertex_pet
DB_SSLMODE=disable
DB_SEARCH_PATH=pet
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# --- JWT ---
# ใส่ PEM ตรงๆ (production ควรมาจาก Secret) ถ้าว่างจะ fallback ไปอ่าน JWT_PUBLIC_KEY_PATH
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ISSUER=
JWT_AUDIENCE=

# --- Downstream ---
EVENT_SERVICE_URL=http://localhost:4002
EVENT_PUBLISH_TIMEOUT=5s

# --- Logging ---
LOG_LEVEL=info
LOG_BODY=false
