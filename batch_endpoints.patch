+func createLitterLogsBatch(c *fiber.Ctx) error {
+	petID := c.Params("id")
+	var logs []LitterLog
+	if err := c.BodyParser(&logs); err != nil {
+		return sendError(c, 400, "Cannot parse JSON array")
+	}
+	
+	parsedPetID, err := uuid.Parse(petID)
+	if err != nil {
+		return sendError(c, 400, "Invalid Pet ID")
+	}
+	
+	for i := range logs {
+		logs[i].PetID = parsedPetID
+		if logs[i].ID == uuid.Nil {
+			logs[i].ID = uuid.New()
+		}
+	}
+
+	DB.Create(&logs)
+	return c.Status(201).JSON(logs)
+}
